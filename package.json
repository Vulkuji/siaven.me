{
  "name": "siaven-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .build-ssr && node tools/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "export": "node tools/export.mjs",
    "format": "prettier --write src content tools/*.mjs package.json tsconfig.json vite.config.ts index.html 404.html wrangler.jsonc README.md",
    "format:check": "prettier --check src content tools/*.mjs package.json tsconfig.json vite.config.ts index.html 404.html wrangler.jsonc README.md"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.52.0",
    "motion": "14.0.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
