{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siaven-me",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "kv_namespaces": [
    { "binding": "RESUME_STORE", "id": "1274875d66bf4b2f85d0ef7ac5d6294b" },
  ],
  "ratelimits": [
    {
      "name": "RESUME_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "routes": [{ "pattern": "siaven.me", "custom_domain": true }],
}
